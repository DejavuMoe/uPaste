# uPaste native service configuration.
#
# Install as /etc/upaste/upaste.env with root:upaste ownership and 0640 mode.
# The service unit reads this file and runs as the unprivileged upaste user.
#
# Both listeners stay on loopback. A trusted reverse proxy provides TLS and the
# public origins shown below.
UPASTE_ADDR=127.0.0.1:8080
UPASTE_FILE_ADDR=127.0.0.1:8081

# Public File origin. It MUST be a distinct origin from the application origin.
UPASTE_FILE_ORIGIN=https://files.example.com

UPASTE_DATA_DIR=/var/lib/upaste

# Trust forwarded client-identity headers only from the directly connected
# reverse proxy. Do not use 0.0.0.0/0 or ::/0. Leave this empty when uPaste is
# reached directly without a proxy.
UPASTE_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
