# uPaste native service configuration.
#
# Install as /etc/upaste/upaste.env with root:upaste ownership and 0640 mode.
# The service unit reads this file and runs as the unprivileged upaste user.
#
# The default deployment mode is private: anonymous creation without a
# challenge, optional expiration including Never, and no admin surface.
UPASTE_DEPLOYMENT_MODE=private

# Both listeners stay on loopback. A trusted reverse proxy provides TLS and the
# public origins shown below.
UPASTE_ADDR=127.0.0.1:8080
UPASTE_FILE_ADDR=127.0.0.1:8081

# Public File origin. It MUST be a distinct origin from the application origin.
UPASTE_FILE_ORIGIN=https://files.example.com

UPASTE_DATA_DIR=/var/lib/upaste

# Trust forwarded client-identity headers only from the directly connected
# reverse proxy. Do not use 0.0.0.0/0 or ::/0. Leave this empty when uPaste is
# reached directly without a proxy.
UPASTE_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# ---------------------------------------------------------------------------
# Public mode (Internet-facing anonymous instance)
#
# Public mode requires exactly one challenge provider and a Superadmin token.
# It also requires finite retention. Defaults are 24h default / 168h maximum.
#
# UPASTE_DEPLOYMENT_MODE=public
# UPASTE_PUBLIC_DEFAULT_TTL=24h
# UPASTE_PUBLIC_MAX_TTL=168h
#
# Recommended self-hosted provider: Cap Standalone.
# UPASTE_CHALLENGE_PROVIDER=cap
# UPASTE_CAP_ENDPOINT=https://cap.example.com
# UPASTE_CAP_SITE_KEY=<cap site key>
# UPASTE_CAP_SECRET_KEY=<cap site secret; never the Cap admin key>
#
# Alternative provider: Cloudflare Turnstile.
# UPASTE_CHALLENGE_PROVIDER=turnstile
# UPASTE_TURNSTILE_SITE_KEY=<turnstile site key>
# UPASTE_TURNSTILE_SECRET_KEY=<turnstile secret key>
# UPASTE_TURNSTILE_HOSTNAME=paste.example.com
#
# One high-entropy Superadmin capability, generated offline as
# up_a1_<unpadded-base64url 32 random bytes>. Never use a human password.
# UPASTE_ADMIN_TOKEN=up_a1_replace-with-a-generated-token
