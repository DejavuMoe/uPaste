# uPaste two-origin reverse-proxy example.
#
# Replace the example hostnames and certificate paths. TLS terminates here.
# The application and File origins MUST remain distinct hostnames.

# Optional HTTP-to-HTTPS redirect for both public origins.
server {
    listen 80;
    listen [::]:80;
    server_name paste.example.com files.example.com;
    return 301 https://$host$request_uri;
}

# Application origin: frontend, API, raw text, healthz.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name paste.example.com;

    ssl_certificate     /etc/letsencrypt/live/paste.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/paste.example.com/privkey.pem;

    # 64 MiB File limit plus multipart overhead.
    client_max_body_size 70m;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Stream uploads and do not buffer large responses.
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_connect_timeout 10s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
    }
}

# File origin: attachments only, served by the separate uPaste listener.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name files.example.com;

    ssl_certificate     /etc/letsencrypt/live/files.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/files.example.com/privkey.pem;

    # The file origin exposes only /f/:id. Never add CORS or upload routes here.
    location /f/ {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_request_buffering off;
        proxy_buffering off;
        proxy_connect_timeout 10s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
    }

    location / {
        return 404;
    }
}
